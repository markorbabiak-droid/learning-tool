# Your secret API key — never commit this
.env

# Python's internal compiled files — you don't need to track these
__pycache__/
*.pyc
*.pyo

# Mac metadata files — not part of the project
.DS_Store

# Generated session data — recreate by running the pipeline
data/sessions/*
!data/sessions/.gitkeep

# Scratch files
input1.txt
claude_code_research_paper.txt

# Debug output from failed API parse attempts
data/debug_response.txt
data/sessions/debug_*.txt
